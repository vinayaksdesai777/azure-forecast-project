{
    "name": "ls_salesforce",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "type": "Salesforce",
        "typeProperties": {
            "environmentUrl": "https://login.salesforce.com",
            "username": "<salesforce_user>",
            "password": {
                "type": "SecureString",
                "value": "<salesforce_password>"
            },
            "securityToken": {
                "type": "SecureString",
                "value": "<salesforce_security_token>"
            }
        },
        "annotations": [],
        "description": "Salesforce source. AutoResolve IR (cloud, no SHIR). Password and security token stored as SecureString — ADF encrypts at publish. Set real values via ADF Studio UI."
    }
}
