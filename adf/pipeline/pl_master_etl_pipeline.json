{
    "name": "pl_master_etl_pipeline",
    "properties": {
        "description": "Master orchestration: Landing Parquet → Silver → Gold via Databricks notebooks. No Azure SQL. Metadata from Unity Catalog via 00_get_metadata notebook.",
        "activities": [
            {
                "name": "Check Source Files Exist",
                "description": "Checks that ADF already landed Parquet files before kicking off Silver.",
                "type": "GetMetadata",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:05:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30
                },
                "typeProperties": {
                    "dataset": {
                        "referenceName": "ds_landing_parquet",
                        "type": "DatasetReference",
                        "parameters": {
                            "folderPath": {
                                "value": "@pipeline().parameters.landing_path",
                                "type": "Expression"
                            },
                            "fileName": "*"
                        }
                    },
                    "fieldList": [
                        "exists",
                        "childItems"
                    ]
                }
            },
            {
                "name": "If Source Files Exist",
                "type": "IfCondition",
                "dependsOn": [
                    {
                        "activity": "Check Source Files Exist",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "typeProperties": {
                    "expression": {
                        "value": "@activity('Check Source Files Exist').output.exists",
                        "type": "Expression"
                    },
                    "ifTrueActivities": [
                        {
                            "name": "Run Silver Notebook",
                            "type": "DatabricksNotebook",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.01:00:00",
                                "retry": 1,
                                "retryIntervalInSeconds": 60
                            },
                            "typeProperties": {
                                "notebookPath": "/Repos/hpe-forecast/databricks/notebooks/01_landing_to_silver",
                                "baseParameters": {
                                    "data_subject": {
                                        "value": "@pipeline().parameters.data_subject",
                                        "type": "Expression"
                                    },
                                    "source_path": {
                                        "value": "@concat('abfss://landing@', pipeline().parameters.storage_account, '.dfs.core.windows.net/', pipeline().parameters.landing_path)",
                                        "type": "Expression"
                                    },
                                    "run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_databricks",
                                "type": "LinkedServiceReference"
                            },
                            "description": "Landing Parquet to Silver: harmonize, structural DQ, type cast, domain DQ, SCD2 merge."
                        },
                        {
                            "name": "Run Gold Notebook",
                            "type": "DatabricksNotebook",
                            "dependsOn": [
                                {
                                    "activity": "Run Silver Notebook",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.01:00:00",
                                "retry": 1,
                                "retryIntervalInSeconds": 60
                            },
                            "typeProperties": {
                                "notebookPath": "/Repos/hpe-forecast/databricks/notebooks/03_silver_to_gold",
                                "baseParameters": {
                                    "data_subject": {
                                        "value": "@pipeline().parameters.data_subject",
                                        "type": "Expression"
                                    },
                                    "batch_id": {
                                        "value": "@json(activity('Run Silver Notebook').output.runOutput).batch_id",
                                        "type": "Expression"
                                    },
                                    "run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_databricks",
                                "type": "LinkedServiceReference"
                            }
                        },
                        {
                            "name": "Run Aggregated Audit Notebook",
                            "type": "DatabricksNotebook",
                            "dependsOn": [
                                {
                                    "activity": "Run Gold Notebook",
                                    "dependencyConditions": [
                                        "Succeeded"
                                    ]
                                }
                            ],
                            "policy": {
                                "timeout": "0.00:30:00",
                                "retry": 1,
                                "retryIntervalInSeconds": 60
                            },
                            "typeProperties": {
                                "notebookPath": "/Repos/hpe-forecast/databricks/notebooks/04_aggregated_audit",
                                "baseParameters": {
                                    "data_subject": {
                                        "value": "@pipeline().parameters.data_subject",
                                        "type": "Expression"
                                    },
                                    "batch_id": {
                                        "value": "@json(activity('Run Gold Notebook').output.runOutput).batch_id",
                                        "type": "Expression"
                                    },
                                    "run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_databricks",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ],
                    "ifFalseActivities": [
                        {
                            "name": "Log No Source Files",
                            "description": "No Parquet files in landing — log NO_DATA via audit notebook.",
                            "type": "DatabricksNotebook",
                            "typeProperties": {
                                "notebookPath": "/Repos/hpe-forecast/databricks/notebooks/00_get_metadata",
                                "baseParameters": {
                                    "data_subject": {
                                        "value": "@pipeline().parameters.data_subject",
                                        "type": "Expression"
                                    },
                                    "status_override": "NO_DATA",
                                    "run_id": {
                                        "value": "@pipeline().RunId",
                                        "type": "Expression"
                                    }
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_databricks",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            }
        ],
        "parameters": {
            "data_subject": {
                "type": "string",
                "defaultValue": "o9_forecast_daily"
            },
            "landing_path": {
                "type": "string",
                "defaultValue": "o9/daily/"
            },
            "storage_account": {
                "type": "string",
                "defaultValue": "hpeforecastadls"
            }
        },
        "annotations": [
            "ETL",
            "Medallion",
            "Landing-Silver-Gold",
            "No-Azure-SQL"
        ],
        "folder": {
            "name": "o9_data_pipeline"
        }
    }
}
