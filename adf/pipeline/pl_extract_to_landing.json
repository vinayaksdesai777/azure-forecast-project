{
    "name": "pl_extract_to_landing",
    "properties": {
        "description": "Metadata-driven source extraction. Gets extract config from Unity Catalog via 00_get_metadata notebook (no Azure SQL). Extracts SAP HANA (Databricks JDBC) / SQL Server / Salesforce into landing Parquet. Updates watermark via 00_update_watermark notebook after each successful copy.",
        "activities": [
            {
                "name": "Get Extract Metadata",
                "description": "Calls 00_get_metadata notebook which queries hpe_catalog.audit.pipeline_config (Delta) and returns active extract rows as JSON. No Azure SQL Lookup needed.",
                "type": "DatabricksNotebook",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.00:15:00",
                    "retry": 1,
                    "retryIntervalInSeconds": 30
                },
                "typeProperties": {
                    "notebookPath": "/Workspace/Users/vinayakdesai604_gmail.com#ext#@vinayakdesai604gmail.onmicrosoft.com/azure-forecast-project/databricks/notebooks/00_get_metadata",
                    "baseParameters": {
                        "data_subject": {
                            "value": "@pipeline().parameters.data_subject",
                            "type": "Expression"
                        }
                    }
                },
                "linkedServiceName": {
                    "referenceName": "ls_databricks",
                    "type": "LinkedServiceReference"
                }
            },
            {
                "name": "ForEach Source Object",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Get Extract Metadata",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Get Extract Metadata').output.runOutput",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "batchCount": 2,
                    "activities": [
                        {
                            "name": "Extract Source",
                            "type": "Switch",
                            "dependsOn": [],
                            "typeProperties": {
                                "on": {
                                    "value": "@item().connector",
                                    "type": "Expression"
                                },
                                "cases": [
                                    {
                                        "value": "SapHana",
                                        "activities": [
                                            {
                                                "name": "Ingest HANA to Landing",
                                                "description": "Reads SAP HANA Cloud via Databricks JDBC (ngdbc.jar). Replaces ADF Copy Activity which requires HDB_CLIENT_WITH_CRYPTO (unavailable on tools.hana.ondemand.com).",
                                                "type": "DatabricksNotebook",
                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.02:00:00",
                                                    "retry": 1,
                                                    "retryIntervalInSeconds": 60
                                                },
                                                "typeProperties": {
                                                    "notebookPath": "/Workspace/Users/vinayakdesai604_gmail.com#ext#@vinayakdesai604gmail.onmicrosoft.com/azure-forecast-project/databricks/notebooks/01_ingest_hana_to_landing",
                                                    "baseParameters": {
                                                        "data_subject":  "@item().data_subject",
                                                        "run_id":        "@pipeline().RunId",
                                                        "new_watermark": "@utcNow('yyyy-MM-dd HH:mm:ss')"
                                                    }
                                                },
                                                "linkedServiceName": {
                                                    "referenceName": "ls_databricks",
                                                    "type": "LinkedServiceReference"
                                                }
                                            }
                                        ]
                                    },
                                    {
                                        "value": "SqlServer",
                                        "activities": [
                                            {
                                                "name": "Copy SQL Server to Landing",
                                                "type": "Copy",
                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.02:00:00",
                                                    "retry": 1,
                                                    "retryIntervalInSeconds": 60
                                                },
                                                "typeProperties": {
                                                    "source": {
                                                        "type": "SqlServerSource",
                                                        "sqlReaderQuery": {
                                                            "value": "@concat('SELECT * FROM [', item().source_schema, '].[', item().source_object, ']', if(equals(item().load_type, 'incremental'), concat(' WHERE [', item().watermark_column, '] > ''', item().last_watermark, ''''), ''))",
                                                            "type": "Expression"
                                                        }
                                                    },
                                                    "sink": {
                                                        "type": "ParquetSink",
                                                        "storeSettings": {
                                                            "type": "AzureBlobFSWriteSettings"
                                                        },
                                                        "formatSettings": {
                                                            "type": "ParquetWriteSettings"
                                                        }
                                                    },
                                                    "enableStaging": false
                                                },
                                                "inputs": [
                                                    {
                                                        "referenceName": "ds_sql_server_table",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "schemaName": "@item().source_schema",
                                                            "tableName": "@item().source_object"
                                                        }
                                                    }
                                                ],
                                                "outputs": [
                                                    {
                                                        "referenceName": "ds_landing_parquet",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "folderPath": "@item().landing_path",
                                                            "fileName": "@concat(item().data_subject, '_', utcNow('yyyyMMddHHmmss'), '.parquet')"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    },
                                    {
                                        "value": "Salesforce",
                                        "activities": [
                                            {
                                                "name": "Copy Salesforce to Landing",
                                                "type": "Copy",
                                                "dependsOn": [],
                                                "policy": {
                                                    "timeout": "0.02:00:00",
                                                    "retry": 1,
                                                    "retryIntervalInSeconds": 60
                                                },
                                                "typeProperties": {
                                                    "source": {
                                                        "type": "SalesforceServiceCloudV2Source",
                                                        "query": {
                                                            "value": "@concat('SELECT Id, Product_Id__c, Location_Id__c, Forecast_Date__c, Forecast_Qty__c, Revenue_Amount__c, Customer_Id__c, Channel__c, Category__c, Sub_Category__c, Region__c, Country__c, Currency_Code__c, UOM__c, Period_Type__c, Fiscal_Period__c FROM ', item().source_object, if(equals(item().load_type, 'incremental'), concat(' WHERE LastModifiedDate > ', replace(replace(item().last_watermark, ' ', 'T'), 'Z', ''), 'Z'), ''))",
                                                            "type": "Expression"
                                                        },
                                                        "includeDeletedObjects": false
                                                    },
                                                    "sink": {
                                                        "type": "ParquetSink",
                                                        "storeSettings": {
                                                            "type": "AzureBlobFSWriteSettings"
                                                        },
                                                        "formatSettings": {
                                                            "type": "ParquetWriteSettings"
                                                        }
                                                    },
                                                    "enableStaging": false
                                                },
                                                "inputs": [
                                                    {
                                                        "referenceName": "ds_salesforce_object",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "objectApiName": "@item().source_object"
                                                        }
                                                    }
                                                ],
                                                "outputs": [
                                                    {
                                                        "referenceName": "ds_landing_parquet",
                                                        "type": "DatasetReference",
                                                        "parameters": {
                                                            "folderPath": "@item().landing_path",
                                                            "fileName": "@concat(item().data_subject, '_', utcNow('yyyyMMddHHmmss'), '.parquet')"
                                                        }
                                                    }
                                                ]
                                            }
                                        ]
                                    }
                                ],
                                "defaultActivities": []
                            }
                        },
                        {
                            "name": "Update Watermark",
                            "description": "Calls 00_update_watermark notebook to update hpe_catalog.audit.pipeline_config. Replaces old Azure SQL usp_update_extract_watermark stored proc.",
                            "type": "DatabricksNotebook",
                            "dependsOn": [
                                {
                                    "activity": "Extract Source",
                                    "dependencyConditions": ["Succeeded"]
                                }
                            ],
                            "typeProperties": {
                                "notebookPath": "/Workspace/Users/vinayakdesai604_gmail.com#ext#@vinayakdesai604gmail.onmicrosoft.com/azure-forecast-project/databricks/notebooks/00_update_watermark",
                                "baseParameters": {
                                    "data_subject":  "@item().data_subject",
                                    "new_watermark": "@utcNow('yyyy-MM-dd HH:mm:ss')",
                                    "run_id":        "@pipeline().RunId"
                                }
                            },
                            "linkedServiceName": {
                                "referenceName": "ls_databricks",
                                "type": "LinkedServiceReference"
                            }
                        }
                    ]
                }
            },
            {
                "name": "Run Master ETL Pipeline",
                "type": "ExecutePipeline",
                "dependsOn": [
                    {
                        "activity": "ForEach Source Object",
                        "dependencyConditions": ["Succeeded"]
                    }
                ],
                "typeProperties": {
                    "pipeline": {
                        "referenceName": "pl_master_etl_pipeline",
                        "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                        "data_subject": {
                            "value": "@pipeline().parameters.data_subject",
                            "type": "Expression"
                        }
                    }
                }
            }
        ],
        "parameters": {
            "data_subject": {
                "type": "string",
                "defaultValue": "o9_forecast_daily"
            }
        },
        "annotations": ["Extraction", "Source-to-Landing", "Metadata-Driven", "No-Azure-SQL"],
        "folder": {
            "name": "o9_data_pipeline"
        }
    }
}
