{
    "name": "ls_salesforce",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "type": "SalesforceServiceCloud",
        "typeProperties": {
            "environmentUrl": "https://<your-data-cloud-org>.salesforce.com",
            "username": "<salesforce_user>",
            "password": {
                "type": "SecureString",
                "value": "<salesforce_password>"
            },
            "securityToken": {
                "type": "SecureString",
                "value": "<salesforce_security_token>"
            },
            "apiVersion": "59.0"
        },
        "annotations": [],
        "description": "Salesforce Data Cloud org (free trial). Uses SalesforceServiceCloud connector — supports Data Cloud DLO objects (dmle__ prefix). environmentUrl = your Data Cloud org URL (not login.salesforce.com). Set real values via ADF Studio UI."
    }
}
