{
    "name": "ls_sap_hana",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "type": "SapHana",
        "connectVia": {
            "referenceName": "AutoResolveIntegrationRuntime",
            "type": "IntegrationRuntimeReference"
        },
        "typeProperties": {
            "connectionString": "SERVERNODE=<sap_hana_cloud_host>.hanacloud.ondemand.com:443;sslEnabled=true;",
            "authenticationType": "Basic",
            "userName": "<sap_hana_user>",
            "password": {
                "type": "SecureString",
                "value": "<sap_hana_password>"
            }
        },
        "annotations": [],
        "description": "SAP HANA Cloud source. AutoResolve IR (cloud-to-cloud, no SHIR). Password stored as SecureString — ADF encrypts at publish. Set real values via ADF Studio UI (never commit plaintext passwords)."
    }
}
