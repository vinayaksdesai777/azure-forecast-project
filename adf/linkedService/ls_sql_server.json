{
    "name": "ls_sql_server",
    "type": "Microsoft.DataFactory/factories/linkedservices",
    "properties": {
        "type": "SqlServer",
        "connectVia": {
            "referenceName": "shir-onprem",
            "type": "IntegrationRuntimeReference"
        },
        "typeProperties": {
            "connectionString": "Data Source=<sql_server_host>;Initial Catalog=<database>;Integrated Security=False;User ID=<sql_user>;",
            "password": {
                "type": "SecureString",
                "value": "<sql_server_password>"
            }
        },
        "annotations": [],
        "description": "SQL Server source. SHIR required for on-prem; switch connectVia to AutoResolve for Azure SQL. Password stored as SecureString — ADF encrypts at publish. Set real value via ADF Studio UI."
    }
}
