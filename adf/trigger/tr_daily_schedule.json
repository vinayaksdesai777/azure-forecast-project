{
    "name": "tr_daily_schedule",
    "type": "Microsoft.DataFactory/factories/triggers",
    "properties": {
        "type": "ScheduleTrigger",
        "typeProperties": {
            "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "startTime": "2024-01-01T06:00:00Z",
                "timeZone": "UTC",
                "schedule": {
                    "hours": [
                        6
                    ],
                    "minutes": [
                        0
                    ]
                }
            }
        },
        "pipelines": [
            {
                "pipelineReference": {
                    "referenceName": "pl_extract_to_landing",
                    "type": "PipelineReference"
                },
                "parameters": {
                    "data_subject": "o9_forecast_daily",
                    "landing_path": "o9/daily/",
                    "storage_account": "hpeforecastadls"
                }
            }
        ],
        "annotations": [],
        "description": "Fires pl_extract_to_landing, which extracts this subject from its source into landing Parquet and then chains into pl_master_etl_pipeline for the silver and gold load. Pointing a trigger straight at the master pipeline would reprocess whatever Parquet already sits in landing and never pull new source rows."
    }
}
